{
  "name": "Noor",
  "categories": [
    "impact"
  ],
  "typography": {
    "fontFamily": "Anton",
    "fontWeight": 900,
    "fontSize": 6.2,
    "letterSpacing": 0.02,
    "wordSpacing": 0.1,
    "textCase": "uppercase"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffd84d",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "tag-color",
      "label": "Tagged words",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "quote-color",
      "label": "Quote",
      "type": "color",
      "default": "#9ce874",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-color",
      "label": "Outline",
      "type": "color",
      "default": "#000000",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-thickness",
      "label": "Outline thickness",
      "type": "float",
      "default": 0.015,
      "min": 0,
      "max": 0.1,
      "step": 0.005,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 15,
      "minChars": 5
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 1,
    "maxWidthRatio": 0.8
  },
  "alignment": {
    "verticalAlign": "bottom",
    "verticalOffset": 0.82,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "carry_quotes",
      "enabled": true
    },
    {
      "type": "smart_punctuation",
      "enabled": true
    }
  ],
  "unsupportedUserAgents": [
    "firefox"
  ]
}
